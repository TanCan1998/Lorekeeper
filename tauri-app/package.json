{
  "name": "lorekeeper-tauri",
  "version": "1.0.0-beta.2",
  "description": "AI Novel Writer — Tauri 2 迁移版前端（Electron 基线保留于仓库根，用于上游同步）",
  "author": "AI Novel Writer Maintainers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:contract": "node --test scripts/installer-contract.node-test.mjs scripts/release-helpers.node-test.mjs scripts/windows-identity.node-test.mjs scripts/artifact-retention.node-test.mjs scripts/atomgit-release.node-test.mjs scripts/icon-frames.node-test.mjs",
    "icons:compose": "node scripts/compose-icon-frames.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:channels": "node scripts/verify-channel-coverage.mjs",
    "check:channels:emit": "node scripts/verify-channel-coverage.mjs --quiet --emit",
    "build:identity": "node scripts/build-windows-identity.mjs",
    "mirror:release": "node scripts/mirror-published-release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@uiw/react-codemirror": "^4.25.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "electron": "^44.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^4.10.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
