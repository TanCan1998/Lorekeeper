# tauri-app 自身配置（仓库根 .npmrc 属于 Electron 基线，保持上游同源不动）
shamefully-hoist=true
auto-install-peers=true
# 关闭 pnpm 自动切换版本：版本由 packageManager 字段与本仓库 CI 显式固定，
# 避免不同 pnpm 主版本静默接管。
#
# 注意：pnpm 12 起会把 packageManager 钉住的版本写入 pnpm-lock.yaml 的
# packageManagerDependencies（含各平台 @pnpm/exe 条目），且 --frozen-lockfile
# 会校验该块；这是 v12 的正常格式，不是多余的锁文件内容，勿手工删除。
manage-package-manager-versions=false
