{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreKeeper",
  "version": "1.0.0-beta.1",
  "identifier": "com.tancan1998.lorekeeper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5190",
    "beforeBuildCommand": "pnpm build && node scripts/build-windows-identity.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoreKeeper",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "1.0.1.0",
        "upgradeCode": "ed3e3199-4ddc-501a-a745-179a185e8dfb",
        "language": "zh-CN",
        "fragmentPaths": ["installer/lorekeeper-install-record.wxs"],
        "componentRefs": ["LoreKeeperInstallRecord"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "SimpChinese": "installer/SimpChinese.nsh"
        },
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "bundleName": "LoreKeeper",
      "infoPlist": "installer/Info.plist",
      "files": {
        "Resources/安装与卸载说明.txt": "installer/安装与卸载说明.txt"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
