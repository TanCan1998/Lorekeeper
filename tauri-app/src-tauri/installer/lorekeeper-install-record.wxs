<?xml version="1.0" encoding="utf-8"?>
<!--
  全机安装记录（MSI）：身份启动器只按明确记录定位主程序，不搜索、不猜测路径。
  由 tauri.conf.json 的 bundle.windows.wix.fragmentPaths / componentRefs 引用。
  主程序名固定为 lorekeeper.exe，因此这里只记录安装目录，避免目录属性拼接歧义。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="LoreKeeperInstallRecord" Guid="*" Win64="yes">
        <RegistryKey
          Root="HKLM"
          Key="Software\tancan1998\LoreKeeper"
          ForceDeleteOnUninstall="yes"
        >
          <RegistryValue Type="integer" Name="IdentityRecordSchema" Value="1" KeyPath="yes" />
          <RegistryValue
            Type="string"
            Name="IdentityPackageName"
            Value="com.tancan1998.lorekeeper"
          />
          <RegistryValue Type="string" Name="InstallScope" Value="machine" />
          <RegistryValue Type="string" Name="InstallLocation" Value="[INSTALLDIR]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <!-- 保持既有即时执行上下文；非提权时助手明确失败，不等同 SYSTEM/全用户注册。 -->
    <CustomAction
      Id="SetRegisterIdentityCmd"
      Property="WixQuietExecCmdLine"
      Value="&quot;[INSTALLDIR]lorekeeper-activate.exe&quot; --register-identity --quiet"
    />
    <CustomAction
      Id="RegisterIdentity"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec"
      Execute="immediate"
      Return="ignore"
    />
    <CustomAction
      Id="SetUnregisterIdentityCmd"
      Property="WixQuietExecCmdLine"
      Value="&quot;[INSTALLDIR]lorekeeper-activate.exe&quot; --unregister-identity --quiet"
    />
    <CustomAction
      Id="UnregisterIdentity"
      BinaryKey="WixCA"
      DllEntry="WixQuietExec"
      Execute="immediate"
      Return="ignore"
    />
    <!-- WiX 3 的序列内 Custom：条件是元素文本，不是属性也不是子元素。 -->
    <InstallExecuteSequence>
      <!-- 安装/升级的新产品及修复均刷新；完整卸载（包括升级移除旧产品）不注册。 -->
      <Custom Action="SetRegisterIdentityCmd" Before="RegisterIdentity">NOT (REMOVE~="ALL")</Custom>
      <Custom Action="RegisterIdentity" After="InstallFinalize">NOT (REMOVE~="ALL")</Custom>
      <!-- 只在显式完整卸载时注销；在移除文件前调用，避免助手已被删除。 -->
      <Custom Action="SetUnregisterIdentityCmd" Before="UnregisterIdentity">Installed AND (REMOVE~="ALL") AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="UnregisterIdentity" Before="RemoveFiles">Installed AND (REMOVE~="ALL") AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
